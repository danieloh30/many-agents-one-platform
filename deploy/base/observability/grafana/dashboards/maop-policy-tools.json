        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{app=\"tool-service\"}[5m])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ]
