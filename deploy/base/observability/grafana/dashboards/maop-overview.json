      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (rate(maop_runs_started_total[$__rate_interval]))",
          "legendFormat": "{{scenario}}",
          "range": true,
          "instant": false
        }
      ]
    },
