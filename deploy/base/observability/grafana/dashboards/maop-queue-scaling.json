{
  "uid": "maop-queue-scaling",
  "title": "Queue and scaling",
  "tags": [
    "maop"
  ],
  "description": "JetStream consumer backlog, queue age, redeliveries and evidence-agent replicas. Queue numbers come from consumer info; replicas from the Kubernetes API via ops-console.",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Agent platform",
      "type": "dashboards",
      "tags": [
        "maop"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Evidence backlog",
      "description": "pending + in-flight (the KEDA lag signal)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(maop_queue_pending{consumer=\"evidence-agents\"}) + sum(maop_queue_ack_pending{consumer=\"evidence-agents\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ]
    },
