{
  "uid": "maop-model-usage",
  "title": "Model usage",
  "tags": [
    "maop"
  ],
  "description": "Model calls, latency, provider-reported tokens and concurrency permits. The mode label distinguishes LIVE from DETERMINISTIC calls.",
