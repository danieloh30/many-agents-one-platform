# Pinned cluster-scoped platform components (docs/versions.md §4).
# Sourced by demo.sh (scripts/deploy/platform.sh). Keep in step with docs/versions.md.
# Shell syntax: KEY=value, no spaces, no command substitution.

KEDA_CHART_REPO_NAME=kedacore
KEDA_CHART_REPO_URL=https://kedacore.github.io/charts
KEDA_CHART=keda
KEDA_CHART_VERSION=2.21.1
KEDA_RELEASE=keda
KEDA_NAMESPACE=keda

SPIRE_CHART_REPO_NAME=spiffe
SPIRE_CHART_REPO_URL=https://spiffe.github.io/helm-charts-hardened/
SPIRE_CRDS_CHART=spire-crds
SPIRE_CRDS_CHART_VERSION=0.6.1
SPIRE_CHART=spire
SPIRE_CHART_VERSION=0.31.0
# Helm releases live in SPIRE_RELEASE_NAMESPACE; the chart itself creates spire-system and
# spire-server (global.spire.namespaces.create=true), as in the upstream hardened-chart guide.
SPIRE_CRDS_RELEASE=spire-crds
SPIRE_RELEASE=spire
SPIRE_RELEASE_NAMESPACE=spire-mgmt
# Controller class name set in values-openshift.yaml / values.yaml
# (spire-server.controllerManager.className). The ClusterSPIFFEID must carry the same className.
SPIRE_CLASS_NAME=spire-mgmt-spire
# The chart default (0.2.7) trails the 0.3.0 release; pinned explicitly.
SPIFFE_CSI_DRIVER_TAG=0.3.0
