# Copy to .env.local (git-ignored) and fill in. demo.sh reads KEY=value lines; it never prints
# secret values. Variables already set in the environment take precedence.

# --- Model ------------------------------------------------------------------------------------
# live: an OpenAI-compatible endpoint; deterministic: scripted model, labelled in the console.
MAOP_MODEL_MODE=live
# Base URL including the API version path. Default: https://api.openai.com/v1/
MAOP_MODEL_BASE_URL=
# Default: gpt-4o-mini
MAOP_MODEL_NAME=
# Secret. Stored only in the Kubernetes Secret model-credentials (refreshed on every `up`).
# If empty, an exported OPENAI_API_KEY is used instead.
MAOP_MODEL_API_KEY=

# --- Deployment -------------------------------------------------------------------------------
MAOP_NAMESPACE=maop
MAOP_EVIDENCE_MAX_REPLICAS=6
# Expose Jaeger and Grafana through Routes/Ingresses (true|false).
MAOP_EXPOSE_OBSERVABILITY=true
# Set to true when the router/ingress certificate is self-signed (verify/status use curl -k).
MAOP_INSECURE_TLS=false

# --- Workload identity ------------------------------------------------------------------------
# Required with an existing SPIRE / Zero Trust Workload Identity Manager whose trust domain cannot
# be detected. When demo.sh installs SPIRE: defaults to the OpenShift apps domain (or maop.example).
MAOP_SPIRE_TRUST_DOMAIN=
# Optional: className of an existing SPIRE controller manager (detected when possible).
MAOP_SPIRE_CLASS_NAME=
# Optional: SPIRE cluster name for a fresh install (default: OpenShift infrastructure name).
MAOP_SPIRE_CLUSTER_NAME=
# Optional: Workload API socket file name inside the CSI volume (default spire-agent.sock).
MAOP_SPIFFE_SOCKET_NAME=

# --- --platform kubernetes only ---------------------------------------------------------------
# Registry the cluster can pull from, e.g. quay.io/<org> or localhost:5001 for kind.
MAOP_REGISTRY=
# Ingress hosts are console.<domain>, jaeger.<domain>, grafana.<domain>.
MAOP_INGRESS_DOMAIN=127.0.0.1.nip.io
MAOP_INGRESS_CLASS=
MAOP_INGRESS_SCHEME=http
# Set to false for a plain-HTTP local registry (for example kind's localhost:5001); podman only.
MAOP_REGISTRY_TLS_VERIFY=true
# podman or docker (auto-detected); target platform for image builds.
MAOP_CONTAINER_ENGINE=
MAOP_BUILD_PLATFORM=linux/amd64
